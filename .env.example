# SAMANVAY — Environment Variables Example
# Copy this file to .env and fill in real values for production.
# NEVER commit .env with real secrets.

# ===== Application =====
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
FRONTEND_URL=http://localhost:3000

# ===== Database =====
# PostgreSQL (production)
DATABASE_URL=postgresql://samanvay_user:your_secure_password@localhost:5432/samanvay_db
# SQLite (local development fallback)
SQLITE_URL=sqlite:///./samanvay_dev.db

# ===== Authentication =====
# Generate with: python -c "import secrets; print(secrets.token_hex(64))"
JWT_SECRET=REPLACE_WITH_STRONG_RANDOM_SECRET_AT_LEAST_64_CHARS
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=8

# ===== Password Hashing =====
# Argon2 parameters (production)
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST=65536
ARGON2_PARALLELISM=1

# ===== Digital Credential Signing =====
# Ed25519 key file path (NEVER store keys in env vars)
# Generate with: python -c "from cryptography.hazmat.primitives.asymmetric.ed25519 import Ed25519PrivateKey; k = Ed25519PrivateKey.generate(); ..."
CREDENTIAL_SIGNING_KEY_PATH=/secure/keys/samanvay_signing_key.pem
CREDENTIAL_SIGNING_KEY_ID=samanvay-demo-key-2026-v1

# ===== Rate Limiting =====
RATE_LIMIT_LOGIN_ATTEMPTS=5
RATE_LIMIT_WINDOW_SECONDS=900
RATE_LIMIT_BACKEND=memory  # or: redis

# ===== Redis (for rate limiting in production) =====
REDIS_URL=redis://localhost:6379/0

# ===== APAAR Integration (DISABLED — do not enable without authorization) =====
# OfficialProvider requires authorized credentials from government agency.
# Setting APAAR_PROVIDER=official will only work if valid API credentials are configured.
# Without them, OfficialProvider returns UNAVAILABLE — never OFFICIALLY_VERIFIED.
APAAR_PROVIDER=demo
# APAAR_API_BASE_URL=https://api.apaar.gov.in/v1  # Only if officially authorized
# APAAR_CLIENT_ID=                                 # Requires government onboarding
# APAAR_CLIENT_SECRET=                             # NEVER hardcode
# APAAR_CERT_PATH=                                 # Mutual TLS certificate path

# ===== Audit Log =====
AUDIT_HMAC_SECRET=REPLACE_WITH_STRONG_AUDIT_CHAIN_SECRET
AUDIT_STORE=database  # or: append-only-file

# ===== CORS =====
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://your-production-domain.in

# ===== Demo Mode =====
DEMO_MODE=true
DEMO_SEED_ON_START=true
DEMO_RESET_ENDPOINT_ENABLED=true  # Set false in production
